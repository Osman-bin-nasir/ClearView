# ─────────────────────────────────────────────────────────────
# ClearView Channels backend — environment template.
# Copy to `.env` locally and fill in. NEVER commit the real .env.
# In production set these in the host's secret store.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=https://api.your-domain.example

# Browser origins allowed to call this API, comma-separated. Leave EMPTY for
# the native Android client — it sends no Origin and needs no CORS headers.
# Never set this to "*" in production.
CORS_ORIGINS=

# ── MongoDB Atlas (REQUIRED) ──────────────────────────────────
# Atlas → Connect → Drivers → SRV string. Keep credentials out of git.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=clearview
MONGO_MAX_POOL_SIZE=10

# ── Auth secrets (REQUIRED) ───────────────────────────────────
# Long random values. e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Pepper for privacy-preserving phone hashing (REQUIRED)
PHONE_HASH_PEPPER=replace-with-a-long-random-pepper
PHONE_HASH_PEPPER_VERSION=1

# ── Bootstrap owner account (ONE-TIME setup) ──────────────────
# Consumed by `npm run create-admin`. Use a STRONG password (min 12 chars);
# a short one is rejected. These values must live only in the host's secret
# store — never in the Android app, never in git. After the owner signs in
# once, additional admins are added from inside the app (Admin → Admins).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_DISPLAY_NAME=ClearView Admin

# ── Product rules ─────────────────────────────────────────────
RETENTION_DAYS=30
# Grace between business expiry and the physical TTL purge (sync window).
PURGE_GRACE_DAYS=30
EDIT_WINDOW_DAYS=30
BAN_PHONE_ENFORCED=true
MAX_TEXT_LENGTH=4000
MAX_CHANNEL_NAME_LENGTH=80
MAX_CHANNEL_DESCRIPTION_LENGTH=500
DEFAULT_PAGE_SIZE=30
MAX_PAGE_SIZE=100
DEFAULT_NOTIFICATIONS_ENABLED=false
MAX_CHANNELS_PER_USER=5

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
AUTH_RATE_LIMIT_MAX=12
WRITE_RATE_LIMIT_MAX=40
REPORT_RATE_LIMIT_MAX=10
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# ── Phone verification (Firebase Phone Auth by default) ───────
PHONE_VERIFY_MODE=firebase
# Development only: log password-reset tokens (never enable in production).
DEV_EXPOSE_RESET_TOKEN=false

# ── Firebase / FCM (required when FCM_ENABLED=true) ───────────
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep newlines escaped in .env; the loader restores them.
FIREBASE_PRIVATE_KEY=

# ── Retention job ─────────────────────────────────────────────
RETENTION_CRON=*/30 * * * *
RETENTION_JOB_ENABLED=true
